{
    "name": "php-io-extensions/soloud",
    "type": "php-ext",
    "description": "1:1 PHP bindings of the SoLoud C++ audio engine, with the library compiled into the extension",
    "keywords": [
        "soloud",
        "audio",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "soloud",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-soloud",
                "description": "Enable the SoLoud bindings",
                "needs-value": false
            }
        ]
    }
}
